  <style>
    @page Section1 {
      size: 21.0cm 29.7cm;
      margin: 1.8cm 1.8cm 1.8cm 1.8cm;
      mso-header-margin: 1.0cm;
      mso-footer-margin: 1.0cm;
      mso-paper-source: 0;
    }
    div.Section1 {
      page: Section1;
    }
    body {
      font-family: 'Segoe UI', Calibri, Arial, Helvetica, sans-serif;
      font-size: 10pt;
      line-height: 1.45;
      color: #1e293b;
      background-color: #ffffff;
      margin: 0;
      padding: 0;
    }
    h1 {
      font-size: 21pt;
      font-weight: 800;
      color: #0f172a;
      margin: 0 0 2px 0;
      letter-spacing: -0.5px;
      text-transform: uppercase;
    }
    .subtitle {
      font-size: 11.5pt;
      font-weight: 700;
      color: #b45309;
      margin: 0 0 10px 0;
      letter-spacing: 0.5px;
    }
    .contact-table {
      width: 100%;
      border-collapse: collapse;
      margin-bottom: 14px;
      border-bottom: 1.5pt solid #cbd5e1;
      padding-bottom: 8px;
    }
    .contact-table td {
      font-size: 9pt;
      color: #475569;
      padding: 2.5px 0;
      vertical-align: middle;
    }
    .contact-table a {
      color: #b45309;
      text-decoration: none;
      font-weight: 600;
    }
    h2.section-title {
      font-size: 11.5pt;
      font-weight: 800;
      color: #0f172a;
      text-transform: uppercase;
      letter-spacing: 0.8px;
      margin: 16px 0 6px 0;
      padding-bottom: 3px;
      border-bottom: 2pt solid #d97706;
    }
    p {
      margin: 0 0 8px 0;
      color: #334155;
      font-size: 9.5pt;
      text-align: justify;
    }
    .entry-header {
      width: 100%;
      border-collapse: collapse;
      margin-top: 8px;
      margin-bottom: 2px;
    }
    .entry-title {
      font-size: 10pt;
      font-weight: 700;
      color: #0f172a;
    }
    .entry-org {
      font-size: 9.5pt;
      font-weight: 600;
      color: #b45309;
    }
    .entry-date {
      font-size: 8.5pt;
      color: #64748b;
      text-align: right;
      font-style: italic;
    }
    ul.bullet-list {
      margin: 4px 0 10px 0;
      padding-left: 18px;
    }
    ul.bullet-list li {
      margin-bottom: 4px;
      font-size: 9.2pt;
      color: #334155;
    }
    .skills-table {
      width: 100%;
      border-collapse: collapse;
      margin-top: 6px;
      margin-bottom: 10px;
    }
    .skills-table td {
      padding: 4.5px 6px;
      font-size: 9pt;
      vertical-align: top;
      border: 1px solid #e2e8f0;
    }
    .skill-category {
      font-weight: 700;
      color: #0f172a;
      width: 28%;
      background-color: #f8fafc;
    }
    .skill-items {
      color: #334155;
      width: 72%;
    }
    .project-card {
      margin-top: 8px;
      margin-bottom: 11px;
      padding-bottom: 8px;
      border-bottom: 0.75pt dashed #cbd5e1;
    }
    .project-title {
      font-size: 10pt;
      font-weight: 800;
      color: #0f172a;
    }
    .project-stack {
      font-size: 8.5pt;
      font-weight: 700;
      color: #b45309;
      font-family: Consolas, 'Courier New', monospace;
      margin: 1px 0 3px 0;
    }
    .project-desc {
      font-size: 9pt;
      color: #475569;
      line-height: 1.4;
    }
    .footer-note {
      margin-top: 24px;
      padding-top: 10px;
      border-top: 1pt solid #cbd5e1;
      font-size: 8pt;
      color: #94a3b8;
      text-align: center;
      font-style: italic;
    }
  </style>
</head>
<body>
  <div class="Section1">
    <!-- Header -->
